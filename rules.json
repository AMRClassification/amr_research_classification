// Rule System

{
  "conditional_rules": [
    {
      "rule_id": "unique_rule_identifier",
      "if": {
        "description": "Description of the condition.", // AND/OR
        "text_contains": ["list of keywords or phrases"],  // AND/OR
        "text_does_not_contain": ["list of keywords or phrases"],  // AND/OR
        "exclusions": ["terms or concepts to exclude if present in text"]
       
      },
      "then": {
        "classification": "Research Area",
        "explanation": "The reasoning for the classification based on keywords and exclusions."
      }
    }
  ]
}


// Constraints

{
  "classification_constraints": {
    "max_classifications": 3,  // Limit to 3 classifications per abstract
    "min_confidence": 0.80,  // Only assign classifications with confidence ≥ 0.80
    "exclusive_categories": {  // Avoid assigning conflicting categories
      "Basic Research": ["Policy", "Operational"],
      "Operational": ["Policy"]
    }
  }
}


